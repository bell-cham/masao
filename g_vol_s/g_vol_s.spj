      <LayerParam4>&lt;param name="layer{0}-{1}-f" value="{2}"&gt;</LayerParam4>
      <MapParam>&lt;param name="chizu-{0}" value="{1}"&gt;</MapParam>
      <FileExt>html</FileExt>
      <OutputDir />
      <RunFile />
    </DefaultConfigurations>
