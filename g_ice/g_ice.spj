    <param type="string" value="http://www.t3.rim.or.jp/~naoto/j_con/index.html" desc="リンク土管2の移動先" name="url2" category="リンク土管" row="0" stage="0" />
    <param type="string" value="http://www.t3.rim.or.jp/~naoto/naoto.html" desc="リンク土管3の移動先" name="url3" category="リンク土管" row="0" stage="0" />
    <param type="string" value="http://www.t3.rim.or.jp/~naoto/j_con/index.html" desc="リンク土管4の移動先" name="url4" category="リンク土管" row="0" stage="0" />
    <param type="string" value="看板" desc="一言メッセージ1 名前" name="hitokoto1_name" category="メッセージ" row="0" stage="0" />
    <param type="text" value="ここ付近、暗さが増します&#xD;&#xA;黄色い結晶をとりながら進もう&#xD;&#xA;0" desc="一言メッセージ1 セリフ" name="hitokoto1" category="メッセージ" row="3" stage="0" />
    <param type="string" value="Orge" desc="一言メッセージ2 名前" name="hitokoto2_name" category="メッセージ" row="0" stage="0" />
    <param type="text" value="穴掘りも頭突きも楽しいよ。好きな方を選んでね。&#xD;&#xA;どっちに進んでもゴールできるよ。&#xD;&#xA;くれぐれも変な遊びに使わないように。" desc="一言メッセージ2 セリフ" name="hitokoto2" category="メッセージ" row="3" stage="0" />
    <param type="string" value="ハーピー" desc="一言メッセージ3 名前" name="hitokoto3_name" category="メッセージ" row="0" stage="0" />
    <param type="text" value="洞窟見学ツアーご苦労様でした。&#xD;&#xA;お代は＄100,000になります。&#xD;&#xA;は？ない？死にさらせ！" desc="一言メッセージ3 セリフ" name="hitokoto3" category="メッセージ" row="3" stage="0" />
    <param type="string" value="看板" desc="一言メッセージ4 名前" name="hitokoto4_name" category="メッセージ" row="0" stage="0" />
    <param type="text" value="体内で一度に熱を作って&#xD;&#xA;周りの敵を一掃できるよ。&#xD;&#xA;俺は燃やさんでね、頼むから。" desc="一言メッセージ4 セリフ" name="hitokoto4" category="メッセージ" row="3" stage="0" />
    <param type="string" value="キドはかせ" desc="説明する人(地図)" name="setumei_name" category="地図" row="0" stage="5" />
    <param type="text" value="よく来た。わしは、キドはかせ。&#xD;&#xA;アイテムの研究をしており、みんなから、&#xD;&#xA;アイテムはかせと呼ばれて、したわれておるよ。" desc="説明する人セリフ1" name="serifu9" category="地図" row="3" stage="5" />
    <param type="string" value="なんでも、質問してくれたまえよ。" desc="説明する人メニュー前置き" name="setumei_menu1" category="地図" row="0" stage="5" />
    <param type="string" value="ファイヤーボール" desc="説明する人メニュー1" name="setumei_menu2" category="地図" row="0" stage="5" />
    <param type="string" value="バリア" desc="説明する人メニュー2" name="setumei_menu3" category="地図" row="0" stage="5" />
    <param type="string" value="ジェット" desc="説明する人メニュー3" name="setumei_menu4" category="地図" row="0" stage="5" />
    <param type="text" value="黄色いチューリップのアイテムと言えば、&#xD;&#xA;そう、ファイヤーボールじゃな。はなれた&#xD;&#xA;敵を攻撃できるという、大変便利なものじゃ。" desc="説明する人セリフ2" name="serifu10" category="地図" row="3" stage="5" />
    <param type="text" value="ピンクのキノコのアイテムと言えば、そう、&#xD;&#xA;バリアじゃな。体当たりで敵を倒せるが、うっかり&#xD;&#xA;して、時間切れを忘れぬよう、注意が必要じゃ。" desc="説明する人セリフ3" name="serifu11" category="地図" row="3" stage="5" />
    <param type="text" value="ロケットの形のアイテムと言えば、そう、ジェット&#xD;&#xA;じゃな。空中で、スペースキーを押せば、さらに&#xD;&#xA;上昇できる。燃料切れには、気を付けるのじゃぞ。" desc="説明する人セリフ4" name="serifu12" category="地図" row="3" stage="5" />
    <param type="color" value="0,0,191" desc="背景色" name="backcolor_@" rel="BACKGROUND" category="表示" row="0" stage="0" />
    <param type="color" value="0,255,255" desc="背景色(ステージ2)" name="backcolor_@_s" rel="BACKGROUND2" category="表示" row="0" stage="2" />
    <param type="color" value="0,255,255" desc="背景色(ステージ3)" name="backcolor_@_t" rel="BACKGROUND3" category="表示" row="0" stage="3" />
    <param type="color" value="0,255,255" desc="背景色(ステージ4)" name="backcolor_@_f" rel="BACKGROUND4" category="表示" row="0" stage="4" />
    <param type="color" value="0,0,0" desc="ステージ番号画面の背景色" name="kaishi_@" rel="BACKGROUNDM" category="表示" row="0" stage="0" />
    <param type="color" value="255,255,255" desc="文字色" name="scorecolor_@" category="表示" row="0" stage="0" />
