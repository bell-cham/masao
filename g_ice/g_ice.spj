<MasaoProject xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <Name>g_ice</Name>
  <ProjVer>1</ProjVer>
  <Runtime>
    <Definitions>
      <Name>普通の正男</Name>
      <Author>RYO</Author>
      <Update />
      <Package>CanvasMasao.js</Package>
      <Configurations>config.sdx</Configurations>
      <ChipDefinition>chipresolv.sdx</ChipDefinition>
      <ChipExtender>ex.png</ChipExtender>
      <Chipset />
      <DefVersion>3.08</DefVersion>
      <RequireLower>1.01</RequireLower>
      <ChipSize>
        <Width>32</Width>
        <Height>32</Height>
      </ChipSize>
      <StageSplit>2</StageSplit>
      <ParamName>map{0}-{1}</ParamName>
      <ParamName2>map{0}-{1}-s</ParamName2>
      <ParamName3>map{0}-{1}-t</ParamName3>
      <ParamName4>map{0}-{1}-f</ParamName4>
      <LayerSplit>2</LayerSplit>
      <LayerName>layer{0}-{1}</LayerName>
      <LayerName2>layer{0}-{1}-s</LayerName2>
      <LayerName3>layer{0}-{1}-t</LayerName3>
      <LayerName4>layer{0}-{1}-f</LayerName4>
      <MapName>map{0}-{1}</MapName>
      <StageSize x="180" y="30" bytesize="1" />
      <LayerSize x="180" y="30" bytesize="2" />
      <MapSize x="15" y="9" bytesize="1" />
    </Definitions>
    <DefaultConfigurations>
      <OutputReplace>
        <repl name="タイトル" value="炎属性　never 冷え性" />
        <repl name="背景の色" value="black" />
        <repl name="文字の色" value="white" />
      </OutputReplace>
      <HeaderHTML>&lt;!DOCTYPE html&gt;
&lt;html lang="ja"&gt;

&lt;head&gt;
&lt;meta charset="UTF-8"&gt;
&lt;title&gt;&lt;?タイトル&gt;&lt;/title&gt;

&lt;script src="CanvasMasao.js"&gt;&lt;/script&gt;
&lt;script src="MasaoKani2.js"&gt;&lt;/script&gt;
&lt;script&gt;
	JSMasao.replaceAll();
&lt;/script&gt;
&lt;/head&gt;

&lt;body style="background-color: &lt;?背景の色&gt;;color: &lt;?文字の色&gt;"&gt;

&lt;div style="text-align: center"&gt;
&lt;applet code="MasaoConstruction.class" width="512" height="320" archive="mc_c.jar"&gt;</HeaderHTML>
      <FooterHTML>&lt;/applet&gt;
&lt;/div&gt;


&lt;hr&gt;

&lt;h2&gt;キーボード操作&lt;/h2&gt;

&lt;dl&gt;
&lt;dt&gt;（←），（４）&lt;/dt&gt;
&lt;dd&gt;左へ歩く。素早く２回押すと走る。&lt;/dd&gt;
&lt;dt&gt;（→），（６）&lt;/dt&gt;
&lt;dd&gt;右へ歩く。素早く２回押すと走る。&lt;/dd&gt;
&lt;dt&gt;（スペース），（Ｚ）&lt;/dt&gt;
&lt;dd&gt;ジャンプする。&lt;/dd&gt;
&lt;dt&gt;（Ｐ）&lt;/dt&gt;
&lt;dd&gt;ポーズ機能／解除。&lt;/dd&gt;
&lt;dt&gt;（Ｔ）&lt;/dt&gt;
&lt;dd&gt;タイトル画面に戻る。&lt;/dd&gt;
&lt;/dl&gt;

&lt;p&gt;ゲーム画面をマウスでクリックすると、ゲーム開始です。&lt;/p&gt;

&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;
&lt;hr&gt;
&lt;h2&gt;お話&lt;/h2&gt;
吾輩はYuである。名前はまだ無い。近くに結晶取り放題の洞窟ができたから行ってくるよ！！&lt;br&gt;
&lt;/body&gt;

&lt;/html&gt;</FooterHTML>
